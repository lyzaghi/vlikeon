{
  "schema_version": 2,
  "service": {
    "listen_address": "127.0.0.1:8443",
    "public_origin": "https://sync.vlikeon.example.org",
    "tls": {
      "certificate_chain_path": "/etc/ssl/vlikeon/sync-chain.crt",
      "private_key_path": "/etc/ssl/vlikeon/sync-privkey.pem",
      "minimum_tls_version": "1.3",
      "ciphers": [
        "TLS_AES_256_GCM_SHA384",
        "TLS_CHACHA20_POLY1305_SHA256",
        "TLS_AES_128_GCM_SHA256"
      ]
    },
    "authentication": {
      "jwt_issuer": "https://auth.vlikeon.example.org",
      "jwt_audience": "https://sync.vlikeon.example.org/v1/sync",
      "clock_skew_leeway_seconds": 30,
      "device_certificate_verification": true
    },
    "storage": {
      "data_directory": "/var/lib/vlikeon/sync-storage",
      "quota_per_account_bytes": 524288000,
      "max_object_bytes": 536870912,
      "chunk_bytes": 262144,
      "staging_ttl_seconds": 86400,
      "sweep_interval_seconds": 3600
    },
    "rate_limits": {
      "requests_per_minute_per_ip": 120,
      "concurrent_transfers_per_account": 2,
      "max_header_bytes": 8192
    }
  }
}
