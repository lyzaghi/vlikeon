# Imported libraries must come from the explicit pinned product decoder receipt.
# This never configures the obsolete upstream bundled-FFmpeg CMake source list.
if(NOT OMNIPLAY_FFMPEG_PREFIX OR NOT IS_ABSOLUTE "${OMNIPLAY_FFMPEG_PREFIX}")
  message(FATAL_ERROR "A pinned OmniPlay FFmpeg product prefix is required")
endif()
if(NOT EXISTS "${OMNIPLAY_FFMPEG_PREFIX}/include/libavcodec/avcodec.h")
  message(FATAL_ERROR "The selected decoder headers are absent")
endif()
foreach(component avformat avcodec swresample swscale avutil)
  set(archive "${OMNIPLAY_FFMPEG_PREFIX}/lib/${component}.lib")
  if(NOT EXISTS "${archive}")
    message(FATAL_ERROR "A declared pinned decoder library is absent: ${component}")
  endif()
  add_library(${component} STATIC IMPORTED GLOBAL)
  set_target_properties(${component} PROPERTIES IMPORTED_LOCATION "${archive}"
    INTERFACE_INCLUDE_DIRECTORIES "${OMNIPLAY_FFMPEG_PREFIX}/include")
endforeach()
set_property(TARGET avformat PROPERTY INTERFACE_LINK_LIBRARIES "avcodec;avutil")
set_property(TARGET avcodec PROPERTY INTERFACE_LINK_LIBRARIES "swresample;avutil")
set_property(TARGET swscale PROPERTY INTERFACE_LINK_LIBRARIES "avutil")
set_property(TARGET swresample PROPERTY INTERFACE_LINK_LIBRARIES "avutil")
if(WIN32)
  set_property(TARGET avutil APPEND PROPERTY INTERFACE_LINK_LIBRARIES "bcrypt;ole32;advapi32")
endif()
