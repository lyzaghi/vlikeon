#!/bin/sh
set -e

case "$1" in
    configure)
        # Refresh desktop database and icon caches
        if [ -x /usr/bin/update-desktop-database ]; then
            /usr/bin/update-desktop-database -q /usr/share/applications || true
        fi
        if [ -x /usr/bin/gtk-update-icon-cache ]; then
            /usr/bin/gtk-update-icon-cache -q /usr/share/icons/hicolor || true
        fi
        if [ -x /usr/bin/update-mime-database ]; then
            /usr/bin/update-mime-database /usr/share/mime || true
        fi

        # Inform systemd about the new user units
        if [ -d /run/systemd/system ]; then
            systemctl --global daemon-reload || true
        fi
    ;;
esac

exit 0
