{
  "manifest_version": 3,
  "incognito": "not_allowed",
  "name": "OmniPlay Game Hub",
  "version": "0.1.0",
  "description": "Your local game library, saved progress and gaming devices.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "desktopCapture",
    "storage",
    "tabs",
    "search"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "Open OmniPlay"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  }
}
